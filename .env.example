# Copie para .env e ajuste. NUNCA commite o .env.

# ---- Escala da API ----
# Numero de replicas (1 a 6). Use scripts/scale.* para mudar com validacao.
API_REPLICAS=2
# Recursos de cada replica (escala vertical)
API_CPUS=1.0
API_MEMORY=768M

# ---- Banco ----
POSTGRES_DB=mundopet
POSTGRES_USER=mundopet
POSTGRES_PASSWORD=troque-esta-senha
# Pool R2DBC por replica. Regra: DB_POOL_MAX x 6 < 200 (max_connections)
DB_POOL_MIN=5
DB_POOL_MAX=20

# ---- MinIO ----
MINIO_ROOT_USER=mundopet
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem
MINIO_BUCKET=mundopet
MINIO_CONSOLE_PORT=9101

# ---- HTTP / protecao ----
HTTP_PORT=8088
RATE_LIMIT_REQUESTS=50

# ---- Entrega (taxa por distancia) ----
# Coordenadas da loja (Google Maps: botao direito no ponto > copiar as coordenadas)
STORE_LAT=-23.5505
STORE_LNG=-46.6333
# Preco fixo por km (R$) e raio maximo de entrega (km)
DELIVERY_PRICE_PER_KM=2.00
DELIVERY_MAX_KM=15
# Distancia em linha reta x este fator ~ caminho pelas ruas
DELIVERY_ROAD_FACTOR=1.3

# ---- Fila ----
QUEUE_CONCURRENCY=16

# ---- Teste de DoS ----
DOS_DURATION=30s
DOS_ATTACK_RPS=500

# ---- Mobile ----
# 10.0.2.2 = host visto pelo emulador Android. Em celular real use o IP da maquina na rede.
MOBILE_API_URL=http://10.0.2.2:8088
